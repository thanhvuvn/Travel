# Root gitignore for Vivu AI multiplatform project

# Node modules
node_modules/
*/node_modules/

# Environment files
.env
.env.local
.env.*.local
*.env

# Expo & React Native
.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Build artifacts
dist/
build/
web-build/
*.tsbuildinfo

# Logs & OS files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
.idea/
.vscode/

.npm-cache/

.test-dist/
