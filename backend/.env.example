# Cổng chạy Express server
PORT=4000

# Chuỗi kết nối Supabase PostgreSQL (Lấy trong Supabase -> Connect -> ORMs -> Prisma)
# 1. Transaction Pooler (port 6543, có ?pgbouncer=true) dùng cho Express API chạy nhanh
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Session Pooler / Direct (port 5432) dùng cho lệnh npx prisma migrate dev
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Khóa bí mật ký JWT Token (Thành viên A dùng cho Auth)
JWT_SECRET="vivu_ai_super_secret_key_change_me"

# Google Gemini API Key (Thành viên B dùng cho AI Planner & Vision AI)
GEMINI_API_KEY=""
